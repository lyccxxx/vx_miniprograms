page {
  background: #f6f7fb;
  color: #1f2d3d;
  font-size: 28rpx;
}

.container {
  padding: 24rpx;
}

.section {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  background: #e8f5e9;
  color: #2e7d32;
  border-radius: 999rpx;
  margin: 8rpx 8rpx 0 0;
  font-size: 24rpx;
}

.button-primary {
  background: linear-gradient(120deg, #4caf50, #66bb6a);
  color: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  text-align: center;
  margin-top: 16rpx;
}

.input {
  border: 1rpx solid #e0e0e0;
  padding: 16rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}
